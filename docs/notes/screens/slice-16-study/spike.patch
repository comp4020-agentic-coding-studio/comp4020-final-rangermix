+// SPIKE (slice 16 study, not for main): what fills the room's two bottom
+// corners, the triangles left of and right of the floor's front point,
+// chosen by ?corners= (none, terrace, garden).
+//   terrace: the pavement in front of the café as paving, with a bench and
+//     a planter on the left and a lamp post and a bicycle rack on the right.
+//   garden: grass round the café, a hedge along its front edges and a tree
+//     and a flower bed in each corner.
+import type { Light } from "./canberra";
+import { ISO, K, toCanvas } from "./iso";
+import { SLAB, block, poly, up } from "./render";
+import type { RoomView } from "./protocol/RoomView";
+import type { Palette } from "./sprites";
+
+type Ctx = CanvasRenderingContext2D;
+
+const Q = typeof location !== "undefined" ? new URLSearchParams(location.search) : new URLSearchParams();
+export const CORNERS = Q.get("corners") ?? "none";
+
+/** The ground round the café's slab, under it: paving or grass, gridded by the room's own tiles. */
+export function drawGround(ctx: Ctx, room: RoomView, palette: Palette, light: Light): void {
+  if (CORNERS === "none") return;
+  const night = light >= 1;
+  const W = room.width;
+  const H = room.height;
+  // Everything below the floor's back corners, outside the slab, is ground.
+  const paving = night ? ["#3a3a4f", "#34344a"] : ["#d9cfc7", "#cfc4bc"];
+  const grass = night ? ["#2d3b39", "#293634"] : ["#a6d39f", "#98c891"];
+  const [a, b] = CORNERS === "garden" ? grass : paving;
+  for (let y = -4; y < H + 8; y++) {
+    for (let x = -8; x < W + 6; x++) {
+      if (x >= 0 && x < W && y >= 1 && y < H) continue;
+      // Only ground in front of the floor's two front edges (x < 0, y >= H):
+      // nothing behind the street wall or the plain wall.
+      if (y < 1 || x >= W) continue;
+      const p = [up(x, y, -SLAB), up(x + 1, y, -SLAB), up(x + 1, y + 1, -SLAB), up(x, y + 1, -SLAB)];
+      poly(ctx, p, (x + y) % 2 ? a : b);
+    }
+  }
+  if (CORNERS === "terrace") {
+    // The kerb: where the pavement meets the road, a line across the bottom.
+    const kerb = night ? "#2a2a3c" : "#b8aca4";
+    for (let x = -8; x < W + 6; x++) {
+      const y = H + 4;
+      poly(ctx, [up(x, y, -SLAB), up(x + 1, y, -SLAB), up(x + 1, y + 0.25, -SLAB), up(x, y + 0.25, -SLAB)], kerb);
+    }
+  }
+}
+
+/** The things standing in the two corners, in front of everything in the room. */
+export function drawCorners(ctx: Ctx, room: RoomView, palette: Palette, light: Light): void {
+  if (CORNERS === "none") return;
+  const night = light >= 1;
+  const W = room.width;
+  const H = room.height;
+  const F = palette.furniture;
+  const z = (v: number) => Math.round(v * K) - SLAB;
+  const at = (x: number, y: number, w: number, h: number, top: number, colour: string, bottom = 0) => block(ctx, x, y, w, h, z(top), colour, z(bottom));
+  if (CORNERS === "terrace") {
+    // Left corner, along the slab's left edge: a bench and two planters.
+    at(-1.75, 5.0, 0.12, 0.12, 7, F[12]);
+    at(-1.75, 7.2, 0.12, 0.12, 7, F[12]);
+    at(-1.3, 5.0, 0.12, 0.12, 7, F[12]);
+    at(-1.3, 7.2, 0.12, 0.12, 7, F[12]);
+    at(-1.85, 4.9, 0.7, 2.5, 9, F[14], 7);
+    at(-1.85, 4.9, 0.15, 2.5, 18, F[14], 9);
+    for (const [px, py] of [
+      [-2.7, 4.9],
+      [-1.0, 8.1],
+    ]) {
+      at(px, py, 0.9, 0.9, 10, F[8]);
+      at(px + 0.08, py + 0.08, 0.74, 0.74, 18, F[6], 10);
+      at(px + 0.2, py + 0.2, 0.5, 0.5, 23, F[7], 18);
+    }
+    // Right corner, in front of the slab's front edge: a table out on the
+    // pavement under an umbrella, two chairs, and a street lamp.
+    at(5.4, 11.3, 0.7, 0.7, 9, F[12], 0);
+    at(4.9, 11.9, 0.6, 0.6, 9, F[11]);
+    at(4.9, 11.9, 0.15, 0.6, 16, F[11], 9);
+    at(6.4, 10.9, 0.6, 0.6, 9, F[11]);
+    at(6.4, 10.9, 0.6, 0.15, 16, F[11], 9);
+    at(5.15, 11.05, 1.2, 1.2, 15, F[5], 13);
+    at(5.7, 11.6, 0.1, 0.1, 40, F[12], 15);
+    at(4.9, 10.8, 1.7, 1.7, 42, F[1], 40);
+    at(5.3, 11.2, 0.9, 0.9, 44, F[1], 42);
+    at(9.3, 11.0, 0.18, 0.18, 46, F[12]);
+    at(9.15, 10.85, 0.48, 0.48, 52, night ? "#f9e2af" : F[5], 46);
+  } else if (CORNERS === "garden") {
+    const hedge = night ? "#3f5a4a" : F[7];
+    const leaf = night ? "#4b6b57" : F[6];
+    // A low hedge along the slab's two front edges.
+    at(-0.75, 1.4, 0.5, H - 1.6, 8, hedge);
+    at(0.2, H + 0.25, W - 0.6, 0.5, 8, hedge);
+    // A tree in each corner: a trunk and a crown.
+    for (const [tx, ty] of [
+      [-2.6, 4.6],
+      [7.6, 11.2],
+    ]) {
+      at(tx + 0.4, ty + 0.4, 0.3, 0.3, 30, F[12]);
+      at(tx, ty, 1.1, 1.1, 54, leaf, 26);
+      at(tx + 0.15, ty + 0.15, 0.8, 0.8, 62, hedge, 54);
+    }
+    // A flower bed by each tree.
+    for (const [fx, fy] of [
+      [-1.9, 7.0],
+      [4.0, 11.2],
+    ]) {
+      at(fx, fy, 1.6, 0.8, 3, F[4]);
+      for (let k = 0; k < 4; k++) {
+        const p = toCanvas(fx + 0.3 + k * 0.35, fy + 0.4);
+        ctx.fillStyle = [F[1], F[9], F[3], F[15]][k];
+        ctx.fillRect(Math.round(p.x), Math.round(p.y - z(5)), 2, 2);
+      }
+    }
+  }
+  void ISO;
+}
